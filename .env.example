# Copy to backend/.env and adjust. All settings use the HFD_ prefix.

# Ollama
HFD_OLLAMA_URL=http://localhost:11434
HFD_OLLAMA_DEFAULT_MODEL=MedGemma:4b

# HuggingFace — set a token to browse gated/private datasets
# HFD_HF_TOKEN=hf_xxx
HFD_HF_TIMEOUT=30

# Paging
HFD_MAX_PAGE_SIZE=50
HFD_DEFAULT_PAGE_SIZE=10
